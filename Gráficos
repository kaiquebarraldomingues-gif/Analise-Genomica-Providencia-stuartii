  "Erythromycin" = "Macrolídeos", "Azithromycin" = "Macrolídeos", "Clarithromycin" = "Macrolídeos",
  "Telithromycin" = "Macrolídeos", "Spiramycin" = "Macrolídeos",
  "Lincomycin" = "Lincosamidas", "Clindamycin" = "Lincosamidas",
