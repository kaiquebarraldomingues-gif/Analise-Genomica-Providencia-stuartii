#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# ==============================================================================
# Pipeline: Associação de Determinantes com Fontes Clínicas de Isolamento
# Autor: Kaique Barral Domingues
# ==============================================================================

import os
import sys
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

arq_resistencia = "resistance_summary_all.tsv"
arq_metadados   = "teste3.csv"
saida_media     = "grafico_media.png"
saida_heatmap   = "grafico_prevalencia.png"

for arq in [arq_resistencia, arq_metadados]:
    if not os.path.isfile(arq):
        sys.exit(f"Erro: Arquivo '{arq}' não localizado.")

print("[1/4] Carregando e limpando dados clínicos e determinantes...")
resistance = pd.read_csv(arq_resistencia, sep="\t")
resistance["gene_clean"] = resistance["gene"].str.split("_").str[0]
res_filtered = resistance[resistance["gene_clean"] != "aac(2')-Ia"].copy()

meta = pd.read_csv(arq_metadados, sep=";", skiprows=1)
meta.columns = ["genome_id", "date", "location", "host", "isolation_source"]
meta = meta[meta["isolation_source"] != "Not determined"]

traducao_fontes = {
    'Blood': 'Sangue',
    'Urine': 'Urina',
    'Gastrointestinal/Rectal': 'Gastrointestinal/Retal',
    'Wound/Tissue': 'Ferida/Tecido',
    'Respiratory': 'Trato respiratório'
}
meta["isolation_source"] = meta["isolation_source"].replace(traducao_fontes)

ordem_especifica = [
    'Trato respiratório', 'Ferida/Tecido', 'Gastrointestinal/Retal', 'Urina', 'Sangue'
]

print("[2/4] Cruzando dados e calculando proporções por fonte...")
merged = pd.merge(res_filtered, meta, on="genome_id")
merged = merged[merged["isolation_source"].isin(ordem_especifica)]
merged["isolation_source"] = pd.Categorical(merged["isolation_source"], categories=ordem_especifica, ordered=True)

sample_counts = merged.groupby("isolation_source", observed=True)["genome_id"].nunique()
gene_counts_total = merged.groupby("isolation_source", observed=True).size()
avg_stats = (gene_counts_total / sample_counts).reset_index(name="avg_genes")

top_10_genes = res_filtered["gene_clean"].value_counts().head(10).index
subset_top = merged[merged["gene_clean"].isin(top_10_genes)]

prevalence_raw = (
    subset_top.groupby(["isolation_source", "gene_clean"], observed=True)["genome_id"]
    .nunique()
    .unstack(fill_value=0)
    .astype(float)
)
counts_aligned = sample_counts.reindex(prevalence_raw.index)
prevalence = prevalence_raw.div(counts_aligned, axis=0) * 100

print("[3/4] Exportando Gráfico 1: Média de genes por fonte...")
plt.figure(figsize=(10, 6))
sns.set_theme(style="whitegrid")
ax1 = sns.barplot(data=avg_stats, x="avg_genes", y="isolation_source", palette="mako")
for i in ax1.containers:
    ax1.bar_label(i, fmt="%.2f", padding=4)
plt.title("Média de Genes de Resistência Adquirida por Fonte de Isolamento", fontsize=13, fontweight="bold")
plt.xlabel("Carga Média de Genes por Amostra", fontsize=11)
plt.ylabel("Fonte de Isolamento", fontsize=11)
plt.xlim(0, max(avg_stats["avg_genes"]) * 1.15)
plt.tight_layout()
plt.savefig(saida_media, dpi=300)
plt.close()

print("[4/4] Exportando Gráfico 2: Heatmap dos 10 principais determinantes...")
plt.figure(figsize=(12, 8))
sns.heatmap(
    prevalence, annot=True, fmt=".1f", cmap="YlOrRd",
    vmin=0, vmax=100, cbar_kws={"label": "Prevalência na Fonte (%)"}
)
plt.title("Prevalência dos 10 Principais Genes Adquiridos por Fonte (%)", fontsize=13, fontweight="bold")
plt.xlabel("Determinante Genético de Resistência", fontsize=11)
plt.ylabel("Fonte de Isolamento", fontsize=11)
plt.xticks(fontstyle="italic")
plt.tight_layout()
plt.savefig(saida_heatmap, dpi=300)
plt.close()

print(f"[✓] Concluído! Imagens geradas: '{saida_media}' e '{saida_heatmap}'.")

#!/usr/bin/env Rscript

# ==============================================================================
# Pipeline: Correlação entre Elementos Genéticos Móveis (MGEs) e ARGs
# Autor: Kaique Barral Domingues
# ==============================================================================

suppressPackageStartupMessages({
  library(dplyr)
  library(ggplot2)
  library(patchwork)
  library(ggstatsplot)
})

arquivos_necessarios <- c(
  "resistance_summary_all.tsv",
  "icefinder_summary_all.tsv",
  "isescan_summary_all.tsv",
  "plasmidfinder_summary_all.tsv",
  "phigaro_summary_all.tsv"
)

for (arq in arquivos_necessarios) {
  if (!file.exists(arq)) {
    stop(paste0("Erro: Arquivo requerido não encontrado: ", arq))
  }
}

message("[1/3] Consolidando contagens genômicas de ARGs e MGEs...")
res <- read.delim("resistance_summary_all.tsv", header = TRUE, sep = "\t", check.names = FALSE, row.names = NULL)
ice <- read.delim("icefinder_summary_all.tsv",   header = TRUE, sep = "\t", check.names = FALSE)
is  <- read.delim("isescan_summary_all.tsv",     header = TRUE, sep = "\t", check.names = FALSE)
pla <- read.delim("plasmidfinder_summary_all.tsv", header = TRUE, sep = "\t", check.names = FALSE)
phi <- read.delim("phigaro_summary_all.tsv",     header = TRUE, sep = "\t", check.names = FALSE)

res_counts <- res %>% group_by(genome_id) %>% summarise(count_ARGs = n(), .groups = "drop")
ice_counts <- ice %>% group_by(genome_id) %>% summarise(count_ICE = n(), .groups = "drop")
is_counts  <- is  %>% group_by(genome_id) %>% summarise(count_IS = n(), .groups = "drop")
pla_counts <- pla %>% group_by(genome_id) %>% summarise(count_Plasmid = n(), .groups = "drop")
phi_counts <- phi %>% group_by(genome_id) %>% summarise(count_Prophage = n(), .groups = "drop")

df_master <- res_counts %>%
  left_join(ice_counts, by = "genome_id") %>%
  left_join(is_counts,  by = "genome_id") %>%
  left_join(pla_counts, by = "genome_id") %>%
  left_join(phi_counts, by = "genome_id")

df_master[is.na(df_master)] <- 0

message("[2/3] Gerando painéis estatísticos não-paramétricos...")
p1 <- ggscatterstats(
  data = df_master, x = count_Plasmid, y = count_ARGs,
  type = "nonparametric", xlab = "Número de Plasmídeos",
  ylab = "Genes de Resistência (ARGs)", title = "A: Plasmídeos e ARGs",
  marginal = TRUE, bf.message = FALSE
)

p2 <- ggscatterstats(
  data = df_master, x = count_Prophage, y = count_ARGs,
  type = "nonparametric", xlab = "Número de Profagos",
  ylab = "Genes de Resistência (ARGs)", title = "B: Profagos e ARGs",
  marginal = TRUE, bf.message = FALSE
)

p3 <- ggscatterstats(
  data = df_master, x = count_IS, y = count_ARGs,
  type = "nonparametric", xlab = "Sequências de Inserção (ISs)",
  ylab = "Genes de Resistência (ARGs)", title = "C: ISs e ARGs",
  marginal = TRUE, bf.message = FALSE
)

p4 <- ggscatterstats(
  data = df_master, x = count_ICE, y = count_ARGs,
  type = "nonparametric", xlab = "Elementos Integrativos e Conjugativos (ICEs)",
  ylab = "Genes de Resistência (ARGs)", title = "D: ICEs e ARGs",
  marginal = TRUE, bf.message = FALSE
)

message("[3/3] Exportando painel combinado 2x2...")
figura_6 <- (p1 + p2) / (p3 + p4)
arquivo_saida <- "Figura6_OneHealth_Providencia.png"

ggsave(arquivo_saida, plot = figura_6, width = 15, height = 14, dpi = 300)
message(paste0("[✓] Painel de correlação salvo em: ", arquivo_saida))

#!/usr/bin/env Rscript

# ==============================================================================
# Pipeline: Perfil Epidemiológico Global (Tempo, Espaço, Hospedeiro e Origem)
# Autor: Kaique Barral Domingues
# ==============================================================================

suppressPackageStartupMessages({
  library(dplyr)
  library(ggplot2)
  library(patchwork)
  library(maps)
})

arquivo_entrada <- "metadadossocorro.csv"

if (!file.exists(arquivo_entrada)) {
  stop(paste0("Erro: Arquivo '", arquivo_entrada, "' não localizado."))
}

message("[1/5] Carregando metadados e preparando colunas de análise...")
dados <- read.csv(arquivo_entrada, sep = ";", check.names = FALSE, stringsAsFactors = FALSE)

# Painel A: Distribuição Temporal
message("[2/5] Processando Painel A: Linha do tempo...")
p1 <- dados %>%
  mutate(Year_Num = as.numeric(`Assembly BioSample Collection date`)) %>%
  filter(!is.na(Year_Num)) %>%
  count(Year_Num) %>%
  ggplot(aes(x = Year_Num, y = n)) +
  geom_col(fill = "#4682B4", color = "white") +
  scale_x_continuous(breaks = seq(min(Year_Num, na.rm = TRUE), max(Year_Num, na.rm = TRUE), by = 1)) +
  theme_minimal() +
  theme(
    axis.text.x = element_text(angle = 90, vjust = 0.5, size = 8),
    plot.title = element_text(size = 13, face = "bold")
  ) +
  labs(title = "A: Distribuição Temporal", x = "Ano de Coleta", y = "Número de Isolados")

# Painel B: Mapa Mundial
message("[3/5] Processando Painel B: Heatmap de coordenadas geográficas...")
world_map <- map_data("world")
geo_counts <- dados %>%
  mutate(loc_clean = trimws(tolower(`Assembly BioSample Geographic location`))) %>%
  filter(loc_clean != "not determined" & loc_clean != "") %>%
  count(`Assembly BioSample Geographic location`) %>%
  rename(region = `Assembly BioSample Geographic location`)

# Adequações comuns de nomenclatura cartográfica
geo_counts$region[geo_counts$region == "USA"] <- "USA"
geo_counts$region[geo_counts$region == "United Kingdom"] <- "UK"

map_full <- left_join(world_map, geo_counts, by = "region")

p_map <- ggplot(map_full, aes(x = long, y = lat, group = group, fill = n)) +
  geom_polygon(color = "white", linewidth = 0.1) +
  scale_fill_viridis_c(option = "plasma", na.value = "grey95", name = "Isolados") +
  theme_void() +
  theme(
    legend.position = "bottom",
    plot.title = element_text(size = 13, face = "bold")
  ) +
  labs(title = "B: Distribuição Geográfica Global")

# Painel D: Donut de Hospedeiros
message("[4/5] Processando Painéis D e E: Donut de hospedeiros e fontes clínicas...")
p4 <- dados %>%
  mutate(host_clean = trimws(tolower(`Assembly BioSample Host`))) %>%
  filter(host_clean != "not determined" & host_clean != "") %>%
  count(`Assembly BioSample Host`) %>%
  ggplot(aes(x = 2, y = n, fill = `Assembly BioSample Host`)) +
  geom_bar(stat = "identity", color = "white") +
  coord_polar("y") +
  xlim(0.5, 2.5) +
  theme_void() +
  theme(plot.title = element_text(size = 13, face = "bold")) +
  labs(title = "C: Hospedeiros (One Health)")

# Painel E: Donut de Fontes Clínicas
p5 <- dados %>%
  mutate(src_clean = trimws(tolower(`Assembly BioSample Isolation source`))) %>%
  filter(src_clean != "not determined" & src_clean != "") %>%
  count(`Assembly BioSample Isolation source`) %>%
  ggplot(aes(x = 2, y = n, fill = `Assembly BioSample Isolation source`)) +
  geom_bar(stat = "identity", color = "white") +
  coord_polar("y") +
  xlim(0.5, 2.5) +
  theme_void() +
  theme(plot.title = element_text(size = 13, face = "bold")) +
  labs(title = "D: Fontes Clínicas")

# Combinação do Painel Geral
message("[5/5] Exportando painéis consolidados e individuais...")
figura_1 <- (p1 / p_map) / (p4 + p5) + plot_layout(heights = c(1, 1.5, 1))

ggsave("Figura1_Epidemiologia_Consolidada.png", plot = figura_1, width = 13, height = 16, dpi = 300)
ggsave("Figura1A_Isolation_Time.png", plot = p1, width = 10, height = 6, dpi = 300)
ggsave("Figura1B_Global_Map.png", plot = p_map, width = 12, height = 8, dpi = 300)
ggsave("Figura1C_Hosts_OneHealth.png", plot = p4, width = 8, height = 8, dpi = 300)
ggsave("Figura1D_Clinical_Sources.png", plot = p5, width = 8, height = 8, dpi = 300)

message("[✓] Todas as figuras epidemiológicas foram salvas com sucesso em alta resolução (300 DPI).")
