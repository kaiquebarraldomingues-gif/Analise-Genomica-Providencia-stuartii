#!/usr/bin/env Rscript

# ==============================================================================
# Pipeline: Distribuição da Carga Genética de Resistência por Genoma
# Autor: Kaique Barral Domingues
# ==============================================================================

suppressPackageStartupMessages({
  library(dplyr)
  library(ggplot2)
})

arquivo_entrada <- "resistance_summary_all.tsv"
arquivo_saida   <- "03_carga_genetica_media_mediana.png"

if (!file.exists(arquivo_entrada)) {
  stop(paste0("Erro: Arquivo '", arquivo_entrada, "' não encontrado no diretório atual."))
}

message("[1/3] Carregando determinantes e agrupando por isolado...")
dados <- read.delim(arquivo_entrada, header = TRUE, sep = "\t", check.names = FALSE, quote = "", row.names = NULL)

carga_genetica <- dados %>%
  group_by(genome_id) %>%
  summarise(n_genes = n(), .groups = "drop")

message("[2/3] Calculando parâmetros estatísticos...")
mediana_genes <- median(carga_genetica$n_genes)
media_genes   <- mean(carga_genetica$n_genes)

label_mediana <- paste0("Mediana: ", round(mediana_genes, 1))
label_media   <- paste0("Média: ", round(media_genes, 1))

message("[3/3] Construindo histograma com linhas de tendência central...")
p3 <- ggplot(carga_genetica, aes(x = n_genes)) +
  geom_histogram(binwidth = 2, fill = "#542788", color = "white", alpha = 0.8) +
  geom_vline(aes(xintercept = mediana_genes, color = "Mediana", linetype = "Mediana"), linewidth = 1.2) +
  geom_vline(aes(xintercept = media_genes, color = "Média", linetype = "Média"), linewidth = 1.2) +
  scale_color_manual(
    name = "Estatísticas",
    values = c("Mediana" = "mediumseagreen", "Média" = "khaki"),
    labels = c(label_mediana, label_media)
  ) +
  scale_linetype_manual(
    name = "Estatísticas",
    values = c("Mediana" = "dashed", "Média" = "dotted"),
    labels = c(label_mediana, label_media)
  ) +
  labs(
    title = "Distribuição da Carga de Resistência por Genoma",
    subtitle = "Número total de determinantes identificados por isolado",
    x = "Quantidade de Genes de Resistência",
    y = "Número de Genomas (Frequência)"
  ) +
  theme_minimal(base_size = 14) +
  theme(legend.position = "right")

ggsave(arquivo_saida, plot = p3, width = 10, height = 7, dpi = 300)
message(paste0("[✓] Histograma salvo com sucesso em: ", arquivo_saida))
message(paste0("    Média = ", round(media_genes, 2), " | Mediana = ", round(mediana_genes, 2)))

#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# ==============================================================================
# Pipeline: Distribuição de Genomas por Classes Simultâneas de Antimicrobianos
# Autor: Kaique Barral Domingues
# ==============================================================================

import os
import sys
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

arquivo_entrada = "resistance_summary_all.tsv"
arquivo_saida   = "distribuicao_classes_porcentagem_fora.png"

if not os.path.isfile(arquivo_entrada):
    sys.exit(f"Erro: Arquivo '{arquivo_entrada}' não encontrado.")

print("[1/4] Carregando determinantes e aplicando filtros de resistência intrínseca...")
df = pd.read_csv(arquivo_entrada, sep="\t")
df_filtered = df[~df["gene"].str.startswith("aac(6')", na=False)]

full_class_mapping = {
    'Amoxicillin': 'Penicilinas', 'Amoxicillin+Clavulanic_acid': 'Penicilinas',
    'Ampicillin': 'Penicilinas', 'Ampicillin+Clavulanic_acid': 'Penicilinas',
    'Piperacillin': 'Penicilinas', 'Piperacillin+Tazobactam': 'Penicilinas',
    'Ticarcillin': 'Penicilinas', 'Ticarcillin+Clavulanic_acid': 'Penicilinas',
    'Cefepime': 'Cefalosporinas', 'Cefixime': 'Cefalosporinas',
    'Cefotaxime': 'Cefalosporinas', 'Cefoxitin': 'Cefalosporinas',
    'Ceftazidime': 'Cefalosporinas', 'Ceftriaxone': 'Cefalosporinas',
    'Cephalothin': 'Cefalosporinas',
    'Ertapenem': 'Carbapenêmicos', 'Imipenem': 'Carbapenêmicos', 'Meropenem': 'Carbapenêmicos',
    'Ciprofloxacin': 'Fluoroquinolonas',
    'Amikacin': 'Aminoglicosídeos', 'Gentamicin': 'Aminoglicosídeos',
    'Streptomycin': 'Aminoglicosídeos', 'Tobramycin': 'Aminoglicosídeos',
    'Azithromycin': 'Macrolídeos', 'Erythromycin': 'Macrolídeos',
    'Spiramycin': 'Macrolídeos', 'Telithromycin': 'Macrolídeos',
    'Doxycycline': 'Tetraciclinas', 'Minocycline': 'Tetraciclinas', 'Tetracycline': 'Tetraciclinas',
    'Aztreonam': 'Monobactâmicos',
    'Chloramphenicol': 'Fenicóis', 'Florfenicol': 'Fenicóis',
    'Sulfamethoxazole': 'Sulfonamidas', 'Trimethoprim': 'Trimetoprima',
    'Lincomycin': 'Lincosamidas', 'Clindamycin': 'Lincosamidas',
    'Pristinamycin_IA': 'Estreptograminas', 'Quinupristin': 'Estreptograminas', 'Virginiamycin_S': 'Estreptograminas',
    'Fosfomycin': 'Fosfomicinas', 'Colistin': 'Polimixinas'
}

print("[2/4] Desdobrando determinantes e agrupando por genoma...")
rows = []
for _, row in df_filtered.iterrows():
    res = row["resistance"]
    if pd.isna(res):
        continue
    for ab in [r.strip() for r in str(res).split(";")]:
        if ab in full_class_mapping:
            rows.append({"genome_id": row["genome_id"], "class": full_class_mapping[ab]})

df_expanded = pd.DataFrame(rows)
total_genomes = df["genome_id"].nunique()

genome_class_counts = df_expanded.groupby("genome_id")["class"].nunique().reset_index()
distribution = genome_class_counts["class"].value_counts().sort_index().reset_index()
distribution.columns = ["Num_Classes", "Qtd_Genomas"]
distribution["Porcentagem"] = (distribution["Qtd_Genomas"] / total_genomes) * 100

print("[3/4] Renderizando gráfico com seaborn...")
fig, ax = plt.subplots(figsize=(11, 6))
sns.barplot(data=distribution, x="Num_Classes", y="Porcentagem", palette="YlOrRd", ax=ax)

for i, row in distribution.iterrows():
    pct_label = f"{row['Porcentagem']:.1f}%\n(n={int(row['Qtd_Genomas'])})"
    ax.text(i, row["Porcentagem"] + 0.5, pct_label, ha="center", va="bottom", fontsize=9, fontweight="bold")

ax.set_title("Distribuição Percentual de Genomas por Quantidade de Classes Simultâneas", fontsize=12, pad=15, fontweight="bold")
ax.set_xlabel("Quantidade de Classes de Antimicrobianos com Genes Detectados", fontsize=10)
ax.set_ylabel("Porcentagem de Genomas (%)", fontsize=10)
ax.set_ylim(0, max(distribution["Porcentagem"]) + 5)

print("[4/4] Adicionando legenda lateral informativa e salvando...")
classes_avaliadas = sorted(list(set(full_class_mapping.values())))
classes_str = "\n".join([f"• {c}" for c in classes_avaliadas])
legenda_texto = f"Classes Avaliadas ({len(classes_avaliadas)}):\n{classes_str}"

ax.text(
    1.03, 1.0, legenda_texto,
    transform=ax.transAxes, fontsize=9, verticalalignment="top",
    bbox=dict(boxstyle="round", facecolor="whitesmoke", alpha=0.9, edgecolor="gray")
)

plt.tight_layout()
plt.savefig(arquivo_saida, dpi=300, bbox_inches="tight")
plt.close()
print(f"[✓] Imagem exportada com sucesso em: {arquivo_saida}")

