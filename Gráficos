#!/usr/bin/env Rscript

# ==============================================================================
# Pipeline: Frequência dos Principais Determinantes de Resistência Adquirida
# Autor: Kaique Barral Domingues
# ==============================================================================

suppressPackageStartupMessages({
  library(dplyr)
  library(ggplot2)
})

# Configurações de Entrada e Saída
arquivo_entrada <- "resistance_summary_all.tsv"
arquivo_saida   <- "01_genes_adquiridos_percent.png"
genes_intrinsecos <- c("aac(2')-Ia")

if (!file.exists(arquivo_entrada)) {
  stop(paste0("Erro: Arquivo '", arquivo_entrada, "' não encontrado no diretório atual."))
}

message("[1/3] Carregando e filtrando determinantes intrínsecos...")
dados <- read.delim(
  arquivo_entrada,
  header = TRUE,
  sep = "\t",
  check.names = FALSE,
  quote = "",
  row.names = NULL
)

dados_filtrados <- dados %>%
  filter(!(product %in% genes_intrinsecos))

total_genomas <- length(unique(dados_filtrados$genome_id))

message("[2/3] Calculando frequências relativas dos 15 principais genes...")
top_genes <- dados_filtrados %>%
  group_by(product) %>%
  summarise(n = n_distinct(genome_id), .groups = "drop") %>%
  mutate(porcentagem = (n / total_genomas) * 100) %>%
  top_n(15, porcentagem) %>%
  arrange(desc(porcentagem))

message("[3/3] Gerando e exportando gráfico...")
p1 <- ggplot(top_genes, aes(x = reorder(product, porcentagem), y = porcentagem, fill = porcentagem)) +
  geom_bar(stat = "identity") +
  geom_text(aes(label = paste0(round(porcentagem, 1), "%")), hjust = -0.1, size = 3.5) +
  coord_flip() +
  scale_y_continuous(limits = c(0, 110)) +
  scale_fill_gradient(low = "#feb24c", high = "#f03b20") +
  labs(
    title = "Top 15 Genes de Resistência Adquirida",
    subtitle = "Determinantes cromossômicos intrínsecos removidos da análise",
    x = "Gene / Determinante Adquirido",
    y = "Prevalência nos Genomas (%)"
  ) +
  theme_minimal(base_size = 12) +
  theme(legend.position = "none", panel.grid.minor = element_blank())

ggsave(arquivo_saida, plot = p1, width = 9, height = 7, dpi = 300)
message(paste0("[✓] Imagem gerada com sucesso em: ", arquivo_saida))

