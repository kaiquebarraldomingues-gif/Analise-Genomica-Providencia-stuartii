#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# ==============================================================================
# Pipeline: Predição Automatizada em Lote de ICEs e IMEs via ICEfinder2
# Autor: Kaique Barral Domingues
# ==============================================================================

import os
import sys
import argparse
import traceback
from glob import glob

try:
    from script.checkin import get_fagb
    from script.single import _single
    from script.metaICE import _meta
    from script.config import get_param
except ImportError:
    try:
        from checkin import get_fagb
        from single import _single
        from metaICE import _meta
        from config import get_param
    except ImportError as erro:
        sys.exit(
            f"[ERRO CRÍTICO] Falha ao importar os módulos internos do ICEfinder: {erro}\n"
            "Certifique-se de que o script está localizado na raiz do projeto (junto à pasta 'script/' e 'config.ini')."
        )


def parse_arguments():
    """Configura e valida os argumentos passados via linha de comando."""
    parser = argparse.ArgumentParser(
        description="Pipeline em lote para predição de elementos conjugativos e integrativos móveis (ICEs/IMEs).",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    parser.add_argument(
        "-d", "--input-dir",
        required=True,
        type=str,
        help="Diretório contendo os genomas para análise."
    )
    parser.add_argument(
        "-e", "--extension",
        default="fasta",
        type=str,
        help="Extensão dos arquivos de genoma a pesquisar (ex: fasta, fa, fna, gbk)."
    )
    parser.add_argument(
        "-t", "--type",
        default="Single",
        choices=["Single", "Metagenome"],
        help="Tipo de montagem: 'Single' para genomas bacterianos individuais ou 'Metagenome' para múltiplos contigs/metagenoma."
    )
    return parser.parse_args()


def configurar_ambiente():
    """Valida as diretrizes do config.ini e prepara a estrutura de diretórios temporários e de saída."""
    param = get_param()
    workdir = param[0]

    dir_tmp_fa = os.path.join(workdir, "tmp", "fasta")
    dir_tmp_gb = os.path.join(workdir, "tmp", "gbk")
    dir_result = os.path.join(workdir, "result")

    os.makedirs(dir_tmp_fa, exist_ok=True)
    os.makedirs(dir_tmp_gb, exist_ok=True)
    os.makedirs(dir_result, exist_ok=True)

    return workdir, dir_result


def main():
    args = parse_arguments()

    if not os.path.isdir(args.input_dir):
        sys.exit(f"[ERRO] O diretório informado não existe: '{args.input_dir}'")

    workdir, dir_result = configurar_ambiente()

    padrao_busca = os.path.join(args.input_dir, f"*.{args.extension.lstrip('.')}")
    arquivos_genomas = sorted(glob(padrao_busca))

    if not arquivos_genomas:
        sys.exit(f"[AVISO] Nenhum arquivo com a extensão '.{args.extension}' foi localizado em '{args.input_dir}'.")

    total_arquivos = len(arquivos_genomas)
    print("=" * 70)
    print("           PIPELINE DE EXECUÇÃO EM LOTE - ICEFINDER 2")
    print("=" * 70)
    print(f"[*] Diretório de trabalho: {workdir}")
    print(f"[*] Modo de análise:       {args.type}")
    print(f"[*] Genomas detectados:    {total_arquivos}")
    print("=" * 70 + "\n")

    sucessos = 0
    falhas = 0

    for i, caminho_arquivo in enumerate(arquivos_genomas, start=1):
        nome_arquivo = os.path.basename(caminho_arquivo)
        sample_id = os.path.splitext(nome_arquivo)[0].replace(".fna", "").replace(".fa", "").replace(".gbk", "")

        print(f"\n[{i}/{total_arquivos}] Processando genoma: {sample_id}")
        print("-" * 50)

        try:
            print("[1/3] Validando estrutura de formato e criando ambiente temporário...")
            arquivo_preparado, tipo_detectado = get_fagb(sample_id, caminho_arquivo, intype=args.type)
            print(f"[✓] Formato validado: {tipo_detectado.upper()}")

            print(f"[2/3] Executando predição de sistemas T4SS, relaxases e sítios att (Modo: {args.type})...")
            if args.type == "Single":
                _single(sample_id, arquivo_preparado, tipo_detectado)
            else:
                _meta(sample_id, arquivo_preparado)

            print("[3/3] Consolidando tabelas e mapas gráficos...")
            pasta_saida = os.path.join(dir_result, sample_id)
            print(f"[✓] Concluído com sucesso! Resultados em: {pasta_saida}")
            sucessos += 1

        except Exception as erro:
            print(f"[X] Falha no processamento da amostra '{sample_id}': {erro}")
            traceback.print_exc()
            falhas += 1

    print("\n" + "=" * 70)
    print("                 RESUMO FINAL DA EXECUÇÃO")
    print("=" * 70)
    print(f"Total de amostras processadas com sucesso: {sucessos}/{total_arquivos}")
    if falhas > 0:
        print(f"Total de falhas encontradas:             {falhas}")
    print("=" * 70 + "\n")


if __name__ == "__main__":
    main()
